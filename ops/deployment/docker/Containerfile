ARG BASE_IMAGE=frappe/erpnext
ARG BASE_TAG=develop

FROM ${BASE_IMAGE}:${BASE_TAG}

USER root
COPY --chown=frappe:frappe . /home/frappe/frappe-bench/apps/education

# The repo tracks `education/public/node_modules` as a symlink to a developer-
# specific absolute path. That path does not exist inside the container, and
# flit resolves it while building the wheel. Replace it with an empty directory
# before Python packaging, then let the frontend build repopulate real assets.
RUN rm -f /home/frappe/frappe-bench/apps/education/education/public/node_modules && \
	mkdir -p /home/frappe/frappe-bench/apps/education/education/public/node_modules

USER frappe
WORKDIR /home/frappe/frappe-bench

RUN /home/frappe/frappe-bench/env/bin/pip install --no-cache-dir /home/frappe/frappe-bench/apps/education && \
	cd /home/frappe/frappe-bench/apps/education && \
	yarn install --frozen-lockfile && \
	yarn build && \
	bench build --app education && \
	rm -rf /home/frappe/frappe-bench/apps/education/node_modules /home/frappe/frappe-bench/apps/education/frontend/node_modules
