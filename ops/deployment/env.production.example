# Copy this file to `ops/deployment/.env.production` before running `./deploy.sh`.
# The deploy script copies it to `/etc/education/education.env` on the server.

# Repository and release selection
APP_NAME=education
APP_BRANCH=develop

# Public endpoint and Frappe site identity
SITE_NAME=education.example.com
DOMAIN=education.example.com

# Image build inputs
FRAPPE_IMAGE=frappe/erpnext
FRAPPE_IMAGE_TAG=develop
CUSTOM_IMAGE=education/custom

# Docker Compose runtime
COMPOSE_PROJECT_NAME=education
FRAPPE_HTTP_PORT=8080
TARGET_PLATFORM=linux/amd64

# Database runtime
DB_HOST=db
DB_PORT=3306
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change-this-root-password
SITE_DB_NAME=education_prod
SITE_DB_PASSWORD=change-this-site-db-password
MARIADB_IMAGE=mariadb:11.8

# Redis and Frappe worker settings
REDIS_IMAGE=redis:7-alpine
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379
SOCKETIO_PORT=9000
GUNICORN_THREADS=4
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# Frappe bootstrap credentials
ADMIN_PASSWORD=change-this-administrator-password

# TLS and reverse proxy
ENABLE_LETSENCRYPT=false
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=false
UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=off

# Host validation thresholds
MIN_FREE_DISK_GB=20
MIN_MEMORY_GB=4

# Deployment paths
DEPLOY_BASE_DIR=/opt/education
SERVER_ENV_FILE=/etc/education/education.env
BACKUP_ROOT=/opt/education/backups
BACKUP_RETENTION_DAYS=14
BACKUP_ON_CALENDAR=*-*-* 03:30:00
ENABLE_BACKUP_TIMER=true

# Build behavior
DOCKER_BUILD_NO_CACHE=false
