# Copy these values into your server secret store or a root-owned env file.
# Do not commit real credentials.

# EC2 primary database. This remains the source of truth.
PRIMARY_DB_HOST=127.0.0.1
PRIMARY_DB_PORT=3306
PRIMARY_DB_NAME=
PRIMARY_DB_USER=
PRIMARY_DB_PASSWORD=
PRIMARY_DB_SSL=false

# User used by MariaDB Cloud inbound replication to read the EC2 primary binlog.
PRIMARY_REPLICATION_USER=skysql_replication
PRIMARY_REPLICATION_PASSWORD=

# Hostname or public/private endpoint MariaDB Cloud can reach for the EC2 primary.
PRIMARY_REPLICATION_HOST=
PRIMARY_REPLICATION_PORT=3306

# MariaDB Cloud secondary. Fill username/password only in your secret store.
MARIADB_CLOUD_HOST=serverless-europe-west9.sysp0000.db2.skysql.com
MARIADB_CLOUD_PORT=4049
MARIADB_CLOUD_NAME=
MARIADB_CLOUD_USER=
MARIADB_CLOUD_PASSWORD=
MARIADB_CLOUD_SSL=true

# TLS is required for the cloud connection.
MARIADB_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MARIADB_REPLICATION_USE_SSL=true

# Optional alert target used by replication_healthcheck.py.
SYNC_ALERT_WEBHOOK_URL=
